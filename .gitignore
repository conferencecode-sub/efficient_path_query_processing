__pycache__/
*.pyc
.DS_Store

# Generated/compiled databases -- large binary artifacts, reproducible from
# the run scripts in experiments/, not source. Kuzu's single-file DB format
# means these are plain files, not directories -- no trailing slash.
*.kuzu
**/kuzu_db
**/kuzu_*_db

# Raw and engine-ready graph datasets -- large data dumps (hundreds of MB to
# multiple GB), reproducible via each dataset's own generator/export script,
# not source.
experiments/datasets/

# DuckDB temp-storage spill files from heavy local queries -- transient
# scratch, not source.
/.tmp/

# Accidental nested duplicate of the separate ~/ReCAP repo (has its own
# .git) -- not meant to live inside this repo at all; investigate/remove
# separately rather than committing it.
/ReCAP/

# Paper LaTeX source -- this repo is a conference-submission code artifact;
# paper/manuscript source (incl. anything that could de-anonymize authors,
# e.g. a reviewer response letter) does not belong in it. Moved to
# ~/recap_paper_tex/ (mirroring the same relative paths) instead.
*.tex
